/*
 * hotspot.h — template kredensial WiFi
 *
 * Salin berkas ini menjadi hotspot.h, lalu isi sandi asli.
 * Berkas hotspot.h masuk .gitignore dan tidak akan masuk repository.
 *
 *   cp firmware/esp32-gateway/hotspot.h.example firmware/esp32-gateway/hotspot.h
 *
 * Tanpa berkas ini, papan tetap menyala sebagai hotspot dan mencatat
 * bingkai, hanya jalur uplink tidak tersambung (rtt,-1).
 */
#pragma once

